# Copy this file to .env and fill in your values
# LLM_PROVIDER can be: mock, openai, gemini, ollama
LLM_PROVIDER=ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
# MODEL_NAME=llama3 for ollama (llama3:latest, mistral:latest pulled locally)
MODEL_NAME=llama3
OLLAMA_HOST=http://localhost:11434
AGENT_NAME=Panda
AGENT_ROLE=AI learning assistant
MESSAGE_LIMIT_FREE=10