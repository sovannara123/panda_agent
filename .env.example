# LLM Configuration
# LLM_PROVIDER can be: mock, openai, groq, ollama
LLM_PROVIDER=mock

# API Keys (set ONE based on provider)
# OPENAI_API_KEY=your_openai_key_here
# GROQ_API_KEY=your_groq_key_here
# GEMINI_API_KEY=your_gemini_key_here

# Model Configuration
# For OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# For Groq: openai/gpt-oss-20b, llama-3.1-70b-versatile, mixtral-8x7b-32768
# For Ollama: llama3, mistral, codellama (must be pulled locally)
MODEL_NAME=gpt-4o-mini
OLLAMA_HOST=http://localhost:11434

# Agent Configuration
AGENT_NAME=Nova
AGENT_ROLE=AI learning assistant
AGENT_VERSION=1.0

# Rate Limiting
MESSAGE_LIMIT_FREE=10
MAX_HISTORY=20

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=0.2

# User Plan: free or premium
USER_PLAN=free

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log
LOG_JSON=false