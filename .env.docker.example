# Panda Agent - Docker Environment Configuration
# Copy this file to .env and customize for your deployment

# ============================================
# LLM Provider Configuration
# ============================================
# Options: mock, openai, groq, ollama, gemini
LLM_PROVIDER=ollama

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://ollama:11434
MODEL_NAME=llama3:latest

# OpenAI settings (used when LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# MODEL_NAME=gpt-4o-mini

# Groq settings (used when LLM_PROVIDER=groq)
# GROQ_API_KEY=your_groq_api_key_here
# MODEL_NAME=llama-3.1-70b-versatile

# Gemini settings (used when LLM_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# MODEL_NAME=gemini-pro

# ============================================
# Agent Configuration
# ============================================
AGENT_NAME=NARA
AGENT_ROLE=AI learning assistant
AGENT_VERSION=1.0

# ============================================
# Rate Limiting
# ============================================
MESSAGE_LIMIT_FREE=10
MAX_HISTORY=20

# ============================================
# Retry Configuration
# ============================================
RETRY_ATTEMPTS=3
RETRY_DELAY=0.2

# ============================================
# User Plan
# ============================================
# Options: free, premium
USER_PLAN=premium

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/agent.log
LOG_JSON=false

# ============================================
# Storage
# ============================================
# Data directory (mounted as volume)
# SQLITE_DB_PATH=/app/data/panda.db